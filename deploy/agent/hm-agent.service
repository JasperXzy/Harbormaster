# Harbormaster managed agent service v1
[Unit]
Description=Harbormaster public traffic agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hm-agent
Group=hm-agent
StateDirectory=harbormaster-agent
StateDirectoryMode=0700
Environment=HM_AGENT_REPORT_INTERVAL=10s
EnvironmentFile=/etc/harbormaster/agent.env
LoadCredential=agent-key:/etc/harbormaster/agent.key
Environment=HM_MASTER_KEY_FILE=%d/agent-key
ExecStart=/usr/local/lib/harbormaster/hm-agent serve --interfaces ${HM_AGENT_INTERFACES} --report-interval ${HM_AGENT_REPORT_INTERVAL}
Restart=on-failure
RestartSec=30
TimeoutStopSec=15
UMask=0077
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=multi-user.target
